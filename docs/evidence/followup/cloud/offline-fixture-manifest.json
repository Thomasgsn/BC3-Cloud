                  },
                  {
                    "name": "DLQ_URL",
                    "value": "https://sqs.eu-west-3.amazonaws.com/123456789012/jobs-dead"
                  },
                  {
                    "name": "BC3_PUBLIC_HOST",
                    "value": "support.example.org"
                  },
                  {
                    "name": "BC3_ORIGINS",
                    "value": "https://support.example.org"
                  },
                  {
                    "name": "PYTHONPATH",
                    "value": "/app/src"
                  },
                  {
                    "name": "AWS_EC2_METADATA_DISABLED",
                    "value": "true"
                  },
                  {
                    "name": "POD_IP",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "status.podIP"
                      }
                    }
                  }
                ],
                "command": [
                  "python",
                  "scripts/bootstrap_database.py"
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "runtime",
