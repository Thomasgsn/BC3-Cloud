              {
                "name": "bootstrap",
                "image": "123456789012.dkr.ecr.eu-west-3.amazonaws.com/rncp-bc3/api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "imagePullPolicy": "Always",
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "768Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
