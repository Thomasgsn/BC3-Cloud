      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "traefik-dynamic",
        "namespace": "bc3-test",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "data": {
        "dynamic.yml": "{\"http\": {\"serversTransports\": {\"front-tls\": {\"serverName\": \"front\", \"rootCAs\": [\"/run/trust/ca.crt\"]}, \"api-tls\": {\"serverName\": \"api\", \"rootCAs\": [\"/run/trust/ca.crt\"]}}}}"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ingress",
        "namespace": "bc3-test",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "ingress"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ingress",
              "project": "rncp-bc3"
            },
            "annotations": {
              "checksum/config": "b180a12d42e2e25244626736546a267a92ea6b1fd82b5d12f8d47385a7fc79bf"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "serviceAccountName": "ingress-controller",
            "automountServiceAccountToken": true,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "runAsGroup": 65532,
              "fsGroup": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "traefik",
                "image": "traefik:v3.7.19@sha256:a6c0194dda77bcb804824580f36fa7edc56e315b1acfe933366c8b52844a78a4",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "dynamic",
                    "mountPath": "/etc/traefik",
                    "readOnly": true
                  },
                  {
                    "name": "trust",
                    "mountPath": "/run/trust",
                    "readOnly": true
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8443
                  },
                  {
                    "containerPort": 8082
                  }
                ],
                "args": [
                  "--entrypoints.websecure.address=:8443",
                  "--entrypoints.health.address=:8082",
                  "--ping=true",
                  "--ping.entrypoint=health",
                  "--providers.kubernetesingress=true",
                  "--providers.kubernetesingress.namespaces=bc3-test",
                  "--providers.kubernetesingress.ingressclass=bc3",
                  "--providers.file.filename=/etc/traefik/dynamic.yml",
                  "--api.dashboard=false",
                  "--global.checknewversion=false",
                  "--global.sendanonymoususage=false",
                  "--log.format=json",
                  "--metrics.prometheus=true",
                  "--metrics.prometheus.entrypoint=health"
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ping",
                    "port": 8082
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/ping",
                    "port": 8082
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "dynamic",
                "configMap": {
                  "name": "traefik-dynamic"
                }
              },
              {
                "name": "trust",
                "configMap": {
                  "name": "trust"
                }
              }
            ],
            "terminationGracePeriodSeconds": 30
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ingress",
        "namespace": "bc3-test",
