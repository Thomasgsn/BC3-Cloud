                  },
                  {
                    "name": "DLQ_URL",
                    "value": "https://sqs.eu-west-3.amazonaws.com/123456789012/jobs-dead"
                  },
                  {
                    "name": "BC3_PUBLIC_HOST",
                    "value": "support.example.org"
                  },
                  {
