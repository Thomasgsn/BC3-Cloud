                  },
                  {
                    "name": "runtime",
                    "mountPath": "/run/secrets",
                    "readOnly": true
                  },
                  {
                    "name": "rds-trust",
                    "mountPath": "/run/rds",
                    "readOnly": true
                  }
                ],
                "env": [
                  {
                    "name": "DB_HOST",
                    "value": "bc3.fixture.eu-west-3.rds.amazonaws.com"
                  },
                  {
                    "name": "DB_NAME",
                    "value": "bc3"
                  },
                  {
                    "name": "DB_USER",
                    "value": "bc3admin"
                  },
                  {
                    "name": "DB_SSLROOTCERT",
                    "value": "/run/rds/rds-ca.crt"
                  },
                  {
                    "name": "BC3_STORAGE_MODE",
                    "value": "aws"
                  },
                  {
                    "name": "AWS_REGION",
                    "value": "eu-west-3"
                  },
                  {
                    "name": "S3_BUCKET",
                    "value": "rncp-bc3-offline-fixture"
                  },
                  {
                    "name": "QUEUE_URL",
