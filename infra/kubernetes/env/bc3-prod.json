                  },
                  {
                    "name": "tls",
                    "mountPath": "/run/tls",
                    "readOnly": true
                  }
                ],
                "ports": [
                  {
                    "containerPort": 9091
                  }
                ],
                "command": [
                  "python",
                  "-m",
                  "rncp_bc3.worker"
                ],
                "env": [
                  {
                    "name": "DB_HOST",
                    "value": "db"
                  },
                  {
                    "name": "DB_USER",
                    "value": "bc3_app"
                  },
                  {
                    "name": "S3_ENDPOINT",
                    "value": "https://s3:8343"
                  },
                  {
                    "name": "QUEUE_ENDPOINT",
                    "value": "https://queue:9325"
                  },
                  {
                    "name": "BC3_ORIGINS",
                    "value": "https://bc3.local:8455,https://bc3.local:30443,https://localhost:8455,https://front:8443"
                  },
                  {
                    "name": "PYTHONPATH",
                    "value": "/app/src"
                  }
                ],
                "livenessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 9091,
                    "scheme": "HTTPS"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "runtime",
                "secret": {
                  "secretName": "runtime",
                  "defaultMode": 288
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "worker-tls",
                  "defaultMode": 288
                }
              }
            ],
            "terminationGracePeriodSeconds": 30
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "front",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "front"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "front",
              "project": "rncp-bc3"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "serviceAccountName": "application",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "front",
                "image": "rncp-bc3-front:4",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "192Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "front-secrets",
                    "mountPath": "/run/secrets",
                    "readOnly": true
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8443
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8443,
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8443,
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "front-secrets",
                "secret": {
                  "secretName": "front-runtime",
                  "defaultMode": 288
                }
              }
            ],
            "terminationGracePeriodSeconds": 30
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "front",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        },
        "annotations": {
          "traefik.ingress.kubernetes.io/service.serversscheme": "https",
          "traefik.ingress.kubernetes.io/service.serverstransport": "front-tls@file"
        }
      },
      "spec": {
        "selector": {
          "app": "front"
        },
        "ports": [
          {
            "name": "https",
            "port": 8443,
            "targetPort": 8443
          }
        ]
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "api",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "api"
        },
        "minReplicas": 1,
        "maxReplicas": 3,
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 60
              }
            }
          }
        ],
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "api",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "spec": {
        "minAvailable": 1,
        "selector": {
          "matchLabels": {
            "app": "api"
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "same-namespace-only",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {}
              }
            ]
          }
        ]
      }
    }
  ]
}
