                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "bootstrap",
                    "mountPath": "/run/secrets",
                    "readOnly": true
                  }
                ],
                "command": [
                  "sh",
                  "-ec",
                  "python scripts/bootstrap_database.py && python scripts/create_user.py --username thomas --role agent --password-file /run/secrets/demo_password"
                ],
                "env": [
                  {
                    "name": "DB_USER",
                    "value": "bc3"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              },
              {
                "name": "bootstrap",
                "secret": {
                  "secretName": "bootstrap",
                  "defaultMode": 288,
                  "items": [
                    {
                      "key": "config.json",
                      "path": "config.json"
                    },
                    {
                      "key": "runtime-config.json",
                      "path": "runtime/config.json"
                    },
                    {
                      "key": "ca.crt",
                      "path": "ca.crt"
                    },
                    {
                      "key": "demo_password",
                      "path": "demo_password"
