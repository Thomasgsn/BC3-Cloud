      "metadata": {
        "name": "queue-config",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "data": {
        "elasticmq.conf": "include classpath(\"application.conf\")\nnode-address { protocol = https, host = queue, port = 9325, context-path = \"\" }\nrest-sqs { enabled = true, bind-port = 9324, bind-hostname = \"127.0.0.1\" }\nqueues {\n  jobs-deadletter {}\n  jobs {\n    defaultVisibilityTimeout = 60 seconds\n    delay = 0 seconds\n    receiveMessageWait = 1 seconds\n    deadLettersQueue { name = \"jobs-deadletter\", maxReceiveCount = 3 }\n  }\n}\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "queue-tls-config",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "data": {
        "stunnel.conf": "foreground = yes\npid =\noutput = /dev/stdout\n[queue]\naccept = 0.0.0.0:9325\nconnect = 127.0.0.1:9324\ncert = /run/secrets/server.crt\nkey = /run/secrets/server.key\nsslVersionMin = TLSv1.2\n"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "db",
        "namespace": "bc3-prod",
        "labels": {
          "project": "rncp-bc3"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "db",
              "project": "rncp-bc3"
            }
          },
          "spec": {
            "enableServiceLinks": false,
            "serviceAccountName": "application",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 70,
              "runAsGroup": 70,
              "fsGroup": 70,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "db",
                "image": "rncp-bc3-db:1",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "768Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "pg-socket",
                    "mountPath": "/var/run/postgresql"
                  },
                  {
                    "name": "db-secret",
                    "mountPath": "/run/secrets",
                    "readOnly": true
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "command": [
                  "docker-entrypoint.sh"
                ],
                "args": [
                  "postgres",
                  "-c",
                  "ssl=on",
                  "-c",
                  "ssl_cert_file=/run/secrets/server.crt",
                  "-c",
                  "ssl_key_file=/run/secrets/server.key",
                  "-c",
                  "unix_socket_directories=/var/run/postgresql"
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "bc3"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "bc3"
                  },
                  {
                    "name": "POSTGRES_PASSWORD_FILE",
                    "value": "/run/secrets/db_password"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  },
                  {
                    "name": "PGHOST",
                    "value": "/var/run/postgresql"
                  },
                  {
                    "name": "POSTGRES_INITDB_ARGS",
                    "value": "--auth-host=scram-sha-256"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-h",
                      "127.0.0.1",
                      "-U",
                      "bc3",
                      "-d",
                      "bc3"
                    ]
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "pg"
                }
              },
              {
                "name": "pg-socket",
                "emptyDir": {}
              },
              {
                "name": "db-secret",
                "secret": {
                  "secretName": "db-secret",
                  "defaultMode": 288
                }
              }
            ],
            "terminationGracePeriodSeconds": 30
          }
        },
        "serviceName": "db"
      }
    },
