                "readinessProbe": {
                  "httpGet": {
                    "path": "/-/ready",
                    "port": 9090,
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 5
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "256Mi"
