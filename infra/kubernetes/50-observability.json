              },
              {
                "name": "trust",
                "configMap": {
                  "name": "trust"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "prometheus"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "prometheus-tls",
                  "defaultMode": 288
                }
              }
            ],
            "terminationGracePeriodSeconds": 30
          }
        },
        "strategy": {
          "type": "Recreate"
