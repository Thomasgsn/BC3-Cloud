        }
      },
      "data": {
        "prometheus.yml": "{\"global\": {\"scrape_interval\": \"5s\", \"evaluation_interval\": \"5s\"}, \"rule_files\": [\"/etc/prometheus/rules.yml\"], \"scrape_configs\": [{\"job_name\": \"bc3-api\", \"kubernetes_sd_configs\": [{\"role\": \"pod\", \"namespaces\": {\"names\": [\"bc3-test\"]}}], \"relabel_configs\": [{\"source_labels\": [\"__meta_kubernetes_pod_label_app\"], \"regex\": \"api\", \"action\": \"keep\"}, {\"source_labels\": [\"__meta_kubernetes_pod_container_port_number\"], \"regex\": \"8443\", \"action\": \"keep\"}, {\"source_labels\": [\"__meta_kubernetes_pod_name\"], \"target_label\": \"pod\"}], \"scheme\": \"https\", \"tls_config\": {\"ca_file\": \"/run/trust/ca.crt\", \"server_name\": \"api\"}}, {\"job_name\": \"bc3-worker\", \"kubernetes_sd_configs\": [{\"role\": \"pod\", \"namespaces\": {\"names\": [\"bc3-test\"]}}], \"relabel_configs\": [{\"source_labels\": [\"__meta_kubernetes_pod_label_app\"], \"regex\": \"worker\", \"action\": \"keep\"}, {\"source_labels\": [\"__meta_kubernetes_pod_container_port_number\"], \"regex\": \"9091\", \"action\": \"keep\"}, {\"source_labels\": [\"__meta_kubernetes_pod_name\"], \"target_label\": \"pod\"}], \"scheme\": \"https\", \"tls_config\": {\"ca_file\": \"/run/trust/ca.crt\", \"server_name\": \"worker\"}}]}",
        "rules.yml": "{\"groups\": [{\"name\": \"bc3-slo\", \"rules\": [{\"alert\": \"APIUnavailable\", \"expr\": \"absent(up{job=\\\"bc3-api\\\"}) or (sum(up{job=\\\"bc3-api\\\"}) == 0)\", \"for\": \"15s\", \"labels\": {\"severity\": \"critical\"}, \"annotations\": {\"summary\": \"Aucune instance API ne r\\u00e9pond au monitoring\"}}, {\"alert\": \"APIErrorBudget\", \"expr\": \"sum(rate(bc3_http_requests_total{status=~\\\"5..\\\"}[1m])) / clamp_min(sum(rate(bc3_http_requests_total[1m])),0.001) > 0.01\", \"for\": \"15s\", \"labels\": {\"severity\": \"warning\"}, \"annotations\": {\"summary\": \"Les r\\u00e9ponses 5xx d\\u00e9passent le budget de disponibilit\\u00e9 de projet\"}}, {\"alert\": \"ExportBacklog\", \"expr\": \"bc3_worker_oldest_pending_seconds > 60\", \"for\": \"15s\", \"labels\": {\"severity\": \"warning\"}, \"annotations\": {\"summary\": \"Un export attend depuis plus d\\u2019une minute\"}}]}]}",
        "web.yml": "{\"tls_server_config\": {\"cert_file\": \"/run/server/server.crt\", \"key_file\": \"/run/server/server.key\"}}"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "grafana-provisioning",
        "namespace": "bc3-test",
