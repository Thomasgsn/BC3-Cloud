        }
      },
      "data": {
        "datasource.yml": "{\"apiVersion\": 1, \"datasources\": [{\"name\": \"BC3 Prometheus\", \"uid\": \"bc3-prometheus\", \"type\": \"prometheus\", \"access\": \"proxy\", \"url\": \"https://prometheus:9090\", \"isDefault\": true, \"jsonData\": {\"tlsAuthWithCACert\": true}, \"secureJsonData\": {\"tlsCACert\": \"$__file{/run/grafana-secrets/ca.crt}\"}}, {\"name\": \"BC3 Loki\", \"uid\": \"bc3-loki\", \"type\": \"loki\", \"access\": \"proxy\", \"url\": \"https://loki:3100\", \"jsonData\": {\"tlsAuthWithCACert\": true, \"serverName\": \"loki\"}, \"secureJsonData\": {\"tlsCACert\": \"$__file{/run/grafana-secrets/ca.crt}\"}}]}",
        "dashboard-provider.yml": "{\"apiVersion\": 1, \"providers\": [{\"name\": \"BC3\", \"type\": \"file\", \"disableDeletion\": true, \"options\": {\"path\": \"/var/lib/grafana/dashboards\"}}]}",
        "operations.json": "{\"uid\": \"bc3-operations\", \"title\": \"BC3 \\u00b7 Exploitation et SLO\", \"schemaVersion\": 39, \"version\": 1, \"refresh\": \"5s\", \"time\": {\"from\": \"now-15m\", \"to\": \"now\"}, \"tags\": [\"BC3\", \"local\"], \"panels\": [{\"id\": 1, \"type\": \"timeseries\", \"title\": \"Disponibilit\\u00e9 logique sur 2 minutes\", \"datasource\": {\"type\": \"prometheus\", \"uid\": \"bc3-prometheus\"}, \"targets\": [{\"expr\": \"1 - (sum(rate(bc3_http_requests_total{status=~\\\"5..\\\"}[2m])) / clamp_min(sum(rate(bc3_http_requests_total[2m])),0.001))\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 0, \"y\": 0, \"w\": 12, \"h\": 8}}, {\"id\": 2, \"type\": \"timeseries\", \"title\": \"Latence API p95 (secondes)\", \"datasource\": {\"type\": \"prometheus\", \"uid\": \"bc3-prometheus\"}, \"targets\": [{\"expr\": \"histogram_quantile(0.95,sum by(le)(rate(bc3_http_duration_seconds_bucket[2m])))\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 12, \"y\": 0, \"w\": 12, \"h\": 8}}, {\"id\": 3, \"type\": \"timeseries\", \"title\": \"Requ\\u00eates par seconde\", \"datasource\": {\"type\": \"prometheus\", \"uid\": \"bc3-prometheus\"}, \"targets\": [{\"expr\": \"sum(rate(bc3_http_requests_total[2m]))\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 0, \"y\": 8, \"w\": 12, \"h\": 8}}, {\"id\": 4, \"type\": \"timeseries\", \"title\": \"\\u00c2ge maximal des exports (secondes)\", \"datasource\": {\"type\": \"prometheus\", \"uid\": \"bc3-prometheus\"}, \"targets\": [{\"expr\": \"max(bc3_worker_oldest_pending_seconds)\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 12, \"y\": 8, \"w\": 12, \"h\": 8}}, {\"id\": 5, \"type\": \"timeseries\", \"title\": \"Jobs termin\\u00e9s ou repris\", \"datasource\": {\"type\": \"prometheus\", \"uid\": \"bc3-prometheus\"}, \"targets\": [{\"expr\": \"sum by(result)(bc3_worker_jobs_total)\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 0, \"y\": 16, \"w\": 12, \"h\": 8}}, {\"id\": 6, \"type\": \"timeseries\", \"title\": \"CPU des processus applicatifs\", \"datasource\": {\"type\": \"prometheus\", \"uid\": \"bc3-prometheus\"}, \"targets\": [{\"expr\": \"sum by(job)(rate(process_cpu_seconds_total[2m]))\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 12, \"y\": 16, \"w\": 12, \"h\": 8}}, {\"id\": 7, \"type\": \"logs\", \"title\": \"Logs API et worker (Loki)\", \"datasource\": {\"type\": \"loki\", \"uid\": \"bc3-loki\"}, \"targets\": [{\"expr\": \"{namespace=\\\"bc3-test\\\", app=~\\\"api|worker\\\"}\", \"refId\": \"A\"}], \"gridPos\": {\"x\": 0, \"y\": 24, \"w\": 24, \"h\": 10}}]}"
      }
